[Nemo Action]
Name=Safe Send (Strip Metadata & Copy for Upload)
Comment=Clean EXIF/GPS/Author metadata and copy to clipboard for safe sharing
Exec=/usr/local/bin/clean-clipboard-send %F
Icon-Name=security-high
Selection=S
Extensions=jpg;jpeg;png;webp;heic;heif;avif;tiff;tif;gif;bmp;pdf;docx;xlsx;pptx;doc;xls;ppt;odt;ods;odp;mp4;m4v;mov;mkv;webm;
Quote=double
