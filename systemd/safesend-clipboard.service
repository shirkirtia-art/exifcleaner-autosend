[Unit]
Description=SafeSend Clipboard Auto-Sanitizer (Screenshots & Copied Files)
Documentation=https://github.com/ciphyrtech/exifcleaner-autosend
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/safesend-clipboard
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
