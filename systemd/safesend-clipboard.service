[Unit]
Description=SafeSend Clipboard Auto-Sanitizer (Screenshots & Copied Files)
Documentation=https://github.com/ciphyrtech/exifcleaner-autosend
After=default.target

[Service]
Type=simple
ExecStart=/usr/local/bin/safesend-clipboard
Restart=always
RestartSec=3
Environment="DISPLAY=:0"
Environment="XDG_RUNTIME_DIR=/run/user/%U"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus"

[Install]
WantedBy=default.target
