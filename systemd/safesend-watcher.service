[Unit]
Description=SafeSend Drop-Zone Auto-Clean Service
Documentation=https://github.com/ciphyrtech/exifcleaner-autosend
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/safesend-watcher %h/Desktop/SafeSend
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
