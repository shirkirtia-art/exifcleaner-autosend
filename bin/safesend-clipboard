#!/usr/bin/env python3
"""
SafeSend Clipboard Daemon
Automatically strips metadata from:
1. Screenshots & raw copied images (PrtScn, browser image copy, etc.)
2. Copied files (Ctrl+C in Nemo / Nautilus / Dolphin / File Managers)

When you paste (Ctrl+V) into Discord, Telegram, or any browser, it sends
the 100% metadata-free sanitized image/file without creating duplicate files on disk,
while preserving native file manager copy-paste operations.
"""

import os
import sys
import time
import hashlib
import shutil
import urllib.parse
import subprocess

try:
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('GdkPixbuf', '2.0')
    from gi.repository import Gtk, Gdk, GdkPixbuf, GLib
except ImportError as e:
    print(f"Error: Missing Python GObject libraries: {e}", file=sys.stderr)
    print("Please install python3-gi and gir1.2-gtk-3.0.", file=sys.stderr)
    sys.exit(1)

IMAGE_EXTS = {
    '.jpg', '.jpeg', '.png', '.webp', '.bmp', '.gif', '.tiff', '.tif', '.svg', '.heic', '.avif'
}

DOC_EXTS = {
    '.pdf', '.docx', '.xlsx', '.pptx', '.doc', '.xls', '.ppt',
    '.odt', '.ods', '.odp',
    '.mp4', '.m4v', '.mov', '.mkv', '.avi', '.webm',
    '.mp3', '.wav', '.ogg', '.flac'
}

def notify(title, msg):
    if shutil.which("notify-send"):
        try:
            subprocess.Popen(
                ["notify-send", "-i", "security-high", "-a", "SafeSend", title, msg],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

class ClipboardSanitizer:
    def __init__(self):
        self.display = Gdk.Display.get_default()
        if not self.display:
            print("Error: Could not open default Gdk display.", file=sys.stderr)
            sys.exit(1)

        self.clip = Gtk.Clipboard.get_default(self.display)
        self.seen_pixel_hashes = set()
        self.is_cleaning = False

        # Locate clean binaries
        script_dir = os.path.dirname(os.path.realpath(__file__))
        self.clean_bin = "/usr/local/bin/clean-for-send"
        if not os.path.isfile(self.clean_bin):
            self.clean_bin = os.path.join(script_dir, "clean-for-send")

        self.purge_bin = "/usr/local/bin/clean-auto-purge"
        if not os.path.isfile(self.purge_bin):
            self.purge_bin = os.path.join(script_dir, "clean-auto-purge")

        # Listen for any application copying to clipboard
        self.clip.connect('owner-change', self.on_owner_change)

    def on_owner_change(self, clipboard, event):
        if self.is_cleaning:
            return

        # If the clipboard owner is our own process window, ignore immediately
        if event.owner and event.owner.get_window_type() != Gdk.WindowType.FOREIGN:
            return

        targets_res = clipboard.wait_for_targets()
        if not targets_res or not targets_res[0]:
            return

        targets = [str(t) for t in targets_res[1]]

        # Priority 1: Direct raw image on clipboard (Screenshot or copied image without file URI)
        # We handle this first IF there is no text/uri-list so we never break file copying
        if any(t in targets for t in ['image/png', 'image/jpeg', 'image/bmp']) and 'text/uri-list' not in targets:
            self.handle_raw_screenshot_image()

        # Priority 2: Copied file(s) from PC (Ctrl+C in Nemo / Nautilus / File Manager)
        elif 'text/uri-list' in targets or 'x-special/nemo-copied-files' in targets:
            self.handle_copied_files()

    def handle_raw_screenshot_image(self):
        pix = self.clip.wait_for_image()
        if not pix:
            return

        # Check raw pixel hash to eliminate redundant re-processing loops
        raw_pixels = pix.get_pixels()
        pix_hash = hashlib.sha256(raw_pixels).hexdigest()
        if pix_hash in self.seen_pixel_hashes:
            return

        self.seen_pixel_hashes.add(pix_hash)
        if len(self.seen_pixel_hashes) > 200:
            self.seen_pixel_hashes.pop()

        # Setting the Pixbuf directly on Gtk.Clipboard strips 100% of EXIF, GPS, camera,
        # and comment metadata: GdkPixbuf only stores raw RGB(A) pixel arrays in memory,
        # and GTK generates pristine PNG/JPEG streams with zero metadata for paste requests.
        self.is_cleaning = True
        self.clip.set_image(pix)
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        self.is_cleaning = False

        notify("Screenshot / Image Sanitized",
               "Metadata stripped from clipboard image. Ready to paste!")

    def handle_copied_files(self):
        sel = self.clip.wait_for_contents(Gdk.Atom.intern('text/uri-list', False))
        if not sel:
            return

        raw_data = sel.get_data().decode('utf-8', errors='ignore').strip()
        lines = raw_data.splitlines()

        valid_files = []
        for line in lines:
            line = line.strip()
            if not line.startswith('file://'):
                continue
            local_path = urllib.parse.unquote(line[7:])
            if os.path.isfile(local_path) and not local_path.startswith('/dev/shm/.clean_send'):
                ext = os.path.splitext(local_path)[1].lower()
                if ext in IMAGE_EXTS or ext in DOC_EXTS:
                    valid_files.append(local_path)

        if not valid_files:
            return

        # Create ephemeral session in /dev/shm
        os.makedirs('/dev/shm/.clean_send', mode=0o1777, exist_ok=True)
        session_dir = f"/dev/shm/.clean_send/clip_{os.getpid()}_{time.time_ns()}"
        os.makedirs(session_dir, mode=0o700, exist_ok=True)

        clean_uris = []
        for src_path in valid_files:
            bname = os.path.basename(src_path)
            clean_dest = os.path.join(session_dir, bname)
            try:
                shutil.copy2(src_path, clean_dest)
                if os.path.isfile(self.clean_bin):
                    subprocess.run([self.clean_bin, clean_dest], capture_output=True)
                clean_uris.append(f"file://{clean_dest}")
            except Exception:
                continue

        if not clean_uris:
            shutil.rmtree(session_dir, ignore_errors=True)
            return

        # Build RFC 2483 compliant URI list payload
        uri_payload = "\r\n".join(clean_uris) + "\r\n"

        # Update text/uri-list clipboard target without destroying file manager operations
        self.is_cleaning = True
        if shutil.which("xclip"):
            try:
                p = subprocess.Popen(['xclip', '-selection', 'clipboard', '-t', 'text/uri-list'],
                                     stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                p.communicate(input=uri_payload.encode('utf-8'))
            except Exception:
                pass
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        self.is_cleaning = False

        # Launch auto-purge with a generous 10-minute TTL
        if os.path.isfile(self.purge_bin):
            try:
                subprocess.Popen([self.purge_bin, session_dir, "", "600"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

        if len(clean_uris) == 1:
            notify("File Copied & Sanitized",
                   f"Metadata stripped from '{os.path.basename(clean_uris[0])}'. Ready to paste!")
        else:
            notify("Files Copied & Sanitized",
                   f"Metadata stripped from {len(clean_uris)} files. Ready to paste!")

def main():
    sanitizer = ClipboardSanitizer()
    print("SafeSend Clipboard Daemon running...")
    Gtk.main()

if __name__ == '__main__':
    main()
