#!/usr/bin/env bash
# ==============================================================================
# SafeSend Desktop Drop-Zone Watcher Daemon
# Automatically sanitizes files dropped into ~/Desktop/SafeSend in-place.
# Guarantees zero data loss: files remain intact and ready for safe upload.
# ==============================================================================
set -euo pipefail

WATCH_DIR="${1:-$HOME/Desktop/SafeSend}"
mkdir -p "$WATCH_DIR"

notify() {
    local title="$1"
    local msg="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -i security-high -a "SafeSend Drop-Zone" "$title" "$msg" 2>/dev/null || true
    fi
}

CLEAN_BIN="/usr/local/bin/clean-for-send"
if [[ ! -x "$CLEAN_BIN" ]]; then
    CLEAN_BIN="$(dirname "$(realpath "$0")")/clean-for-send"
fi

# Track recently cleaned files to avoid re-trigger loops from inotify close_write
declare -A PROCESSED_FILES

# Watch for newly created, moved, or written files
inotifywait -m -e close_write,moved_to --format "%w%f" "$WATCH_DIR" 2>/dev/null | while read -r FILEPATH; do
    if [[ ! -f "$FILEPATH" ]]; then
        continue
    fi
    FILENAME="$(basename "$FILEPATH")"

    # Ignore hidden files, README, or partial download files
    if [[ "$FILENAME" == .* || "$FILENAME" == "README"* || "$FILENAME" == *.crdownload || "$FILENAME" == *.part || "$FILENAME" == *.tmp* ]]; then
        continue
    fi

    # Check if this file was modified by our own clean pass within the last 5 seconds
    FILE_MTIME="$(stat -c %Y "$FILEPATH" 2>/dev/null || echo 0)"
    LAST_CLEAN="${PROCESSED_FILES["$FILEPATH"]:-0}"
    if (( FILE_MTIME - LAST_CLEAN < 4 && LAST_CLEAN > 0 )); then
        continue
    fi

    PROCESSED_FILES["$FILEPATH"]="$FILE_MTIME"

    # Clean the file in-place losslessly
    if "$CLEAN_BIN" "$FILEPATH"; then
        notify "SafeSend: Metadata Stripped" "'$FILENAME' is sanitized and ready to share safely!"
    fi
done
